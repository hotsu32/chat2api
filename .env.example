# ============ 基础 ============
API_PREFIX=your_prefix
CHATGPT_BASE_URL=https://chatgpt.com
PROXY_URL=your_first_proxy, your_second_proxy
SCHEDULED_REFRESH=false

# ============ 用户侧 SaaS ============
# 会话签名密钥（生产必配）。不配则用进程内随机密钥 —— 重启掉所有登录、多实例不通用。
# 生成：openssl rand -hex 32
USER_SESSION_SECRET=
# 登录会话有效期（秒），默认 8 小时
USER_SESSION_MAX_AGE=28800
# 站点对外地址（邮件里的验证 / 重置链接用它拼绝对 URL）
SITE_BASE_URL=http://127.0.0.1:5005

# 是否要求邮箱验证（true 时：注册后须点邮件链接验证才能登录 / 购买）
# 注意：true 需要配好下面的 SMTP，否则用户收不到信
REQUIRE_EMAIL_VERIFICATION=false

# ============ 邮件服务 SMTP（邮箱验证 + 找回密码）============
# 未配置时降级为「不发信」，只记日志。
# 常见：163 邮箱 smtp.163.com:465（SSL）| QQ 邮箱 smtp.qq.com:465 | 阿里云邮件推送 | 腾讯云 SES | Resend
# 163/QQ 的 SMTP_PASSWORD 填「授权码」而非登录密码：
#   163 设置 -> POP3/SMTP/IMAP -> 开启 IMAP/SMTP 服务 -> 新增授权密码（只显示 1 次，每号最多 2 个）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# 发件人地址（留空则用 SMTP_USER）
SMTP_FROM=
SMTP_FROM_NAME=Chat-Share
# true=465 SSL；false=587 STARTTLS
SMTP_SSL=true

# ============ Cloudflare Turnstile 人机验证 ============
# 未配置（两项留空）时注册跳过人机校验。
# 申请真实 key：https://dash.cloudflare.com -> Turnstile -> Add widget
#   Widget mode 选 Managed，Hostname 填你的域名（本地调试再加 127.0.0.1 / localhost）
#   拿到 Site Key（公开，进模板）+ Secret Key（保密，只在服务端 siteverify 用）
# 官方测试 key（无需账号，用于联调；Secret 里 1x=总是通过，2x=总是失败）：
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ============ 限流 ============
# 同 IP 每小时注册上限（0 = 关闭限流）
REGISTER_RATE_LIMIT=5
# 登录失败限流，两个桶都要过（0 = 关闭对应的桶）：
#   IP 桶宽 —— 同一出口 NAT 后面可能有整栋楼的正常用户，卡太死会误伤
#   账号桶窄 —— 针对单个账号的撞库，攻击者换 IP 也绕不过去
# 只做其中一个都留着完整的攻击面。账号桶同时管住 /api/password 的原密码尝试。
SIGNIN_IP_RATE_LIMIT=20
SIGNIN_EMAIL_RATE_LIMIT=5
# 账号桶的窗口（秒），默认 15 分钟
SIGNIN_EMAIL_RATE_WINDOW=900
# 邮箱验证 / 重置链接有效期（秒），默认 30 分钟
EMAIL_TOKEN_TTL=1800

# ============ 反代与限流的 IP 来源 ============
# 信任 X-Forwarded-For 的反代 IP 白名单（逗号分隔，支持单 IP / CIDR）。
# 空 = 谁的 XFF 都不信，一律用 TCP 对端 IP。
# 走 Nginx / Cloudflare 时**必须**填上反代的出口 IP，否则所有用户会共用反代出口 IP
# 的同一个限流桶，表现为全员 429。
# 反过来若无条件信任 XFF，任何人加一行请求头就能把限流清零，且无声无息 ——
# 所以这里默认「不信任」：宁可选会响的那个失败方向。
#
# 采信时是**从右往左**逐跳剥掉可信条目，取剩下的第一个，而不是取最左一段。
# Cloudflare 和 Nginx 的 $proxy_add_x_forwarded_for 都是**追加**而非覆盖：
# 客户端自带 "XFF: 1.2.3.4" 时 app 收到的是 "1.2.3.4, <真实IP>"，最左那段是攻击者写的。
# 因此**每一级**反代的出口 IP 都要写进来（CF -> Nginx -> app 就要写两级），
# 漏写中间某一级会让剥离提前停下，把该级的出口 IP 当成客户端 —— 同样是全员挤一个桶。
# 示例：USER_TRUSTED_PROXIES=10.0.0.5,172.16.0.0/12
USER_TRUSTED_PROXIES=

# 是否把邮箱验证 / 密码重置链接直接渲染到页面上（仅本地开发）。
# 生产**必须**保持 false：开着等于「知道任一已注册邮箱就能直接拿到它的重置链接」，
# 无需碰邮箱即可接管账号。
USER_DEBUG_LINKS=false

# ============ 支付 ============
# 支付渠道。留空 = 关闭下单（fail-closed）：没接真实商户号时宁可不能买，
# 也不能让用户点一下就白拿套餐。权益完全由 orders(status=paid) 推导。
#   mock  演示渠道，下单即视为支付成功且不扣款 —— 仅限本地联调，生产禁用
PAYMENT_PROVIDER=
# 未支付订单保留时长（秒）。同套餐的未超时 pending 单会被复用，防连点下单
# 产生多张并行订单（回调把它们全置 paid 会让用户拿到成倍有效期）。
ORDER_PENDING_TTL=1800
